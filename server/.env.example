# ============================================
# CosmicMail Server — Environment Variables
# Copy this file to .env and fill in your values
# ============================================

# Supabase (required for database storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# n8n Webhook (primary integration — form data is POSTed here)
N8N_WEBHOOK_URL=https://yash-ninja.app.n8n.cloud/webhook-test/af53988d-27ee-479b-a28d-3b6276496d46

# Optional: Generic webhook URL for additional integrations
WEBHOOK_URL=WEBHOOK_URL_PLACEHOLDER

# Optional: Mailchimp
MAILCHIMP_API_KEY=MAILCHIMP_API_KEY
MAILCHIMP_AUDIENCE_ID=MAILCHIMP_AUDIENCE_ID
MAILCHIMP_SERVER_PREFIX=us1

# Optional: SendGrid (for confirmation emails)
SENDGRID_API_KEY=SENDGRID_API_KEY
SENDGRID_FROM_EMAIL=noreply@cosmicmail.space

# Optional: Google Sheets webhook
GOOGLE_SHEETS_WEBHOOK_URL=GOOGLE_SHEETS_WEBHOOK_URL

# Double opt-in toggle (set to "true" to enable)
DOUBLE_OPTIN=false

# Server
PORT=5000
FRONTEND_URL=http://localhost:3000
